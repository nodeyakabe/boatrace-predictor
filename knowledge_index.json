  "known_pitfalls": [
    {
      "id": "race_predictor_double_init",
      "name": "RacePredictor 2重初期化",
      "symptom": "検証が遅い（100レースで10分以上かかる）",
      "root_cause": "ベースライン測定と本番測定で別々にRacePredictorを初期化。v1/v2/v3モデルのロード時間が3秒×2回=6秒",
      "solution": "RacePredictorを1回だけ初期化し、feature_flagを動的に切り替える",
      "solution_code": "set_feature_flag('feature_name', True/False) で切り替え",
      "performance_improvement": "60%削減（10分→4分、100レース検証）",
      "first_discovered": "2025-12-18",
      "occurrence_count": 2,
      "related_files": [
        "src/analysis/race_predictor.py",
        "scripts/quick_compare_odds_calibration.py"
      ]
    },
    {
      "id": "verification_logic_mismatch",
      "name": "検証ロジックと本番実装の乖離",
      "symptom": "検証で効果ありと判定したが、本番で効果なし（または逆）",
      "root_cause": "検証スクリプトが独自ロジックで測定、本番実装と異なる条件で評価",
      "solution": "本番実装のコードを直接インポートして検証。テンプレート（scripts/templates/verification_template.py）を使用",
      "first_discovered": "2025-12-17",
      "occurrence_count": 1,
      "related_files": [
        "docs/lessons_learned/PATTERN_OPTIMIZATION_FAILURE_20251217.md",
        "docs/VERIFICATION_PROCESS_IMPROVEMENT_20251217.md"
      ]
    },
    {
      "id": "model_drift_annual",
      "name": "年度間モデルドリフト",
      "symptom": "2024年で有効だった施策が2025年で効果なし",
      "root_cause": "市場環境・データ分布の年度間変化。ベッティング市場の効率化",
      "solution": "必ず最新年度データで再検証。過去データのみで判断しない。導入後も定期的に効果測定",
      "first_discovered": "2025-12-18",
      "occurrence_count": 1,
      "related_files": [
        "docs/improvement_attempts/rank23_odds_calibration_rejection_20251218.md"
      ]
    },
    {
      "id": "accuracy_vs_roi",
      "name": "精度改善とROI改善の乖離",
      "symptom": "的中率は改善するがROIが悪化",
      "example": "コース強制化: 精度+5.6pt、ROI -51pt",
      "root_cause": "低オッズレースばかり的中しても収支は改善しない",
      "solution": "必ずROIで評価。精度改善≠ROI改善",
      "first_discovered": "2025-12-16",
      "related_files": [
        "docs/残タスク一覧.md"
      ]
    }
  ],
