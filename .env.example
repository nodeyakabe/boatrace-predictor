# 環境変数設定ファイル（サンプル）
# このファイルを .env にコピーして、実際の値を設定してください

# 天気API設定（OpenWeatherMap）
WEATHER_API_KEY=your_api_key_here

# データベース設定
DATABASE_PATH=data/boatrace.db

# スクレイピング設定
REQUEST_DELAY=1

# Discord Webhook設定（自動化機能用）
# Webhook URL取得方法: docs/guides/DISCORD_WEBHOOK_SETUP.md を参照
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here
# チャンネル分割（未設定時はDISCORD_WEBHOOK_URLにフォールバック・1チャンネル運用も可）
# DISCORD_WEBHOOK_URL_ALERT=https://discord.com/api/webhooks/your_alert_channel_webhook
# DISCORD_WEBHOOK_URL_LOG=https://discord.com/api/webhooks/your_log_channel_webhook
