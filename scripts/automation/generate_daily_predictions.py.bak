"""
朝の予想生成モジュール

毎朝実行し、本日のレース予想を生成
"""

import os
import sys
import subprocess
from datetime import datetime, timedelta
from pathlib import Path

# プロジェクトルートをパスに追加
project_root = Path(__file__).parent.parent.parent
sys.path.insert(0, str(project_root))

from scripts.automation.notify import send_daily_summary, send_error_notification


def get_todays_race_count(db_path: str) -> int:
    """
    本日のレース数を取得

    Args:
        db_path: データベースパス

    Returns:
        int: レース数
    """
    import sqlite3

    today = datetime.now().strftime('%Y-%m-%d')

    conn = sqlite3.connect(db_path)
    try:
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM races WHERE race_date = ?", (today,))
        count = cursor.fetchone()[0]
        return count
    finally:
        conn.close()


def get_todays_target_count(db_path: str) -> int:
    """
    本日の購入対象レース数を取得

    Args:
        db_path: データベースパス

    Returns:
        int: 購入対象レース数
    """
    import sqlite3

    today = datetime.now().strftime('%Y-%m-%d')

    conn = sqlite3.connect(db_path)
    try:
        cursor = conn.cursor()
        query = """
        SELECT COUNT(DISTINCT r.id)
        FROM races r
        JOIN race_predictions p ON r.id = p.race_id
        WHERE r.race_date = ?
            AND p.rank_prediction = 1
            AND p.prediction_type = 'advance'
        """
        cursor.execute(query, (today,))
        count = cursor.fetchone()[0]
        return count
    finally:
        conn.close()


def generate_todays_predictions() -> bool:
    """
    本日のレース予想を生成

    Returns:
        bool: 成功ならTrue
    """
    today = datetime.now()
    today_str = today.strftime('%Y-%m-%d')
    year = today.year

    print("=" * 60)
    print(f"本日の予想生成開始: {today_str}")
    print("=" * 60)

    # データベースパス
    db_path = project_root / "data" / "boatrace.db"

    if not db_path.exists():
        error_msg = f"データベースが見つかりません: {db_path}"
        print(f"✗ {error_msg}")
        send_error_notification("予想生成失敗", error_msg)
        return False

    # 本日のレース数確認
    race_count = get_todays_race_count(str(db_path))

    if race_count == 0:
        print(f"⚠️ 本日のレースデータがありません")
        print(f"   データ収集を先に実行してください")
        send_error_notification("予想生成スキップ", "本日のレースデータが存在しません")
        return False

    print(f"本日のレース数: {race_count}件")

    # 予想生成スクリプトのパス
    prediction_script = project_root / "scripts" / "prediction" / "generate_predictions.py"

    if not prediction_script.exists():
        error_msg = f"予想生成スクリプトが見つかりません: {prediction_script}"
        print(f"✗ {error_msg}")
        send_error_notification("予想生成失敗", error_msg)
        return False

    # 予想生成実行
    try:
        print("\n予想生成実行中...")

        # 本日の年度のadvance予想を生成（未生成分のみ）
        result = subprocess.run(
            [
                sys.executable,
                str(prediction_script),
                "--years", str(year),
                "--type", "advance",
                "--skip-existing"
            ],
            capture_output=True,
            text=True,
            timeout=1800,  # 30分タイムアウト
            encoding='utf-8',
            errors='replace'
        )

        print("\n--- 予想生成出力 ---")
        print(result.stdout)

        if result.stderr:
            print("\n--- エラー出力 ---")
            print(result.stderr)

        if result.returncode != 0:
            error_msg = f"予想生成スクリプトがエラー終了しました（終了コード: {result.returncode}）"
            print(f"✗ {error_msg}")
            send_error_notification("予想生成失敗", f"{error_msg}\n\n{result.stderr}")
            return False

        print("\n✓ 予想生成完了")

        # 購入対象レース数を取得
        target_count = get_todays_target_count(str(db_path))

        print(f"購入対象レース数: {target_count}件")

        # 完了通知送信
        send_daily_summary(
            date=today_str,
            race_count=race_count,
            target_count=target_count
        )

        return True

    except subprocess.TimeoutExpired:
        error_msg = "予想生成がタイムアウトしました（30分）"
        print(f"✗ {error_msg}")
        send_error_notification("予想生成タイムアウト", error_msg)
        return False

    except Exception as e:
        error_msg = f"予想生成中にエラーが発生: {str(e)}"
        print(f"✗ {error_msg}")
        send_error_notification("予想生成エラー", error_msg)
        return False


def main():
    """メイン処理"""
    print("\n" + "=" * 60)
    print("朝の予想生成")
    print(f"実行時刻: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 60 + "\n")

    success = generate_todays_predictions()

    print("\n" + "=" * 60)
    if success:
        print("✓ 予想生成完了")
    else:
        print("✗ 予想生成失敗")
    print("=" * 60)

    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
