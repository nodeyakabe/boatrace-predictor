@echo off
chcp 65001 >nul
echo ================================================================================
echo 2021年・2023年データ補完 - 本番実行
echo ================================================================================
echo.
echo このスクリプトは2021年・2023年の全月データを収集します
echo 所要時間: 約60-80時間（2.5-3.3日）
echo.
echo 実行内容:
echo   - 2021年: 全12ヶ月（約30-40時間）
echo   - 2023年: 全12ヶ月（約30-40時間）
echo.
echo 出力先:
echo   - data\csv\補完\2021\
echo   - data\csv\補完\2023\
echo.
echo ログファイル:
echo   - log_data_collection_2021_2023.txt
echo.
echo ================================================================================
echo.
pause

echo.
echo データ収集を開始します...
echo ログファイル: log_data_collection_2021_2023.txt
echo.

python scripts\data_collection\補完_2021_2023_一括実行.py > log_data_collection_2021_2023.txt 2>&1

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ================================================================================
    echo データ収集完了
    echo ================================================================================
    echo.
    type log_data_collection_2021_2023.txt | findstr /C:"成功:" /C:"所要時間:" /C:"次のステップ:"
    echo.
    echo 詳細はログファイルを確認してください:
    echo   log_data_collection_2021_2023.txt
    echo.
) else (
    echo.
    echo ================================================================================
    echo エラーが発生しました
    echo ================================================================================
    echo.
    echo ログファイルを確認してください:
    echo   log_data_collection_2021_2023.txt
    echo.
)

pause
